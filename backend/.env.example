# Copy to .env (never commit .env). Without a key the relay runs in MOCK mode.
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_ASR_MODEL=muse-voice-transcribe-1.0
# Set to 1 to force offline mock mode even when a key is present (demo without network).
FOCUSGUARD_MOCK=0
# Optional shared secret the phone must send as X-Relay-Token.
RELAY_TOKEN=
